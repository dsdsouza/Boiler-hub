{
  "name": "boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --grep-invert @known-issue",
    "test:e2e:known": "playwright test --grep @known-issue",
    "test:e2e:all": "playwright test",
    "test:database": "vitest run tests/database",
    "qa:accounts": "node scripts/qa/provision.mjs",
    "qa:session": "node scripts/qa/session.mjs",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "qa:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.6.0",
    "next": "15.5.28",
    "node-ical": "^0.27.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
