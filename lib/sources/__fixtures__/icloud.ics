BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Apple Inc.//iCloud Calendar//EN
CALSCALE:GREGORIAN
X-WR-CALNAME:Example iCloud Calendar
X-WR-TIMEZONE:America/New_York
BEGIN:VTIMEZONE
TZID:America/New_York
BEGIN:DAYLIGHT
DTSTART:20070311T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
END:DAYLIGHT
BEGIN:STANDARD
DTSTART:20071104T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:example-recurring-icloud
DTSTAMP:20261020T120000Z
DTSTART;TZID=America/New_York:20261026T090000
DTEND;TZID=America/New_York:20261026T093000
RRULE:FREQ=DAILY;COUNT=8
EXDATE;TZID=America/New_York:20261028T090000
SUMMARY:Morning check-in
STATUS:CONFIRMED
TRANSP:OPAQUE
END:VEVENT
BEGIN:VEVENT
UID:example-recurring-icloud
DTSTAMP:20261021T120000Z
RECURRENCE-ID;TZID=America/New_York:20261029T090000
DTSTART;TZID=America/New_York:20261029T110000
DTEND;TZID=America/New_York:20261029T120000
SUMMARY:Rescheduled check-in
STATUS:CONFIRMED
TRANSP:OPAQUE
END:VEVENT
BEGIN:VEVENT
UID:example-duration-icloud
DTSTAMP:20261020T120000Z
DTSTART;TZID=America/New_York:20261027T140000
DURATION:PT1H
SUMMARY:Planning\, review and next steps
TRANSP:OPAQUE
END:VEVENT
BEGIN:VEVENT
UID:example-allday-icloud
DTSTAMP:20261020T120000Z
DTSTART;VALUE=DATE:20261030
DTEND;VALUE=DATE:20261031
SUMMARY:Birthday
TRANSP:TRANSPARENT
END:VEVENT
BEGIN:VEVENT
UID:example-deadline-icloud
DTSTAMP:20261020T120000Z
DTSTART;VALUE=DATE:20261101
DTEND;VALUE=DATE:20261102
SUMMARY:Assignment due
TRANSP:OPAQUE
END:VEVENT
BEGIN:VEVENT
UID:example-free-icloud
DTSTAMP:20261020T120000Z
DTSTART:20261027T180000Z
DTEND:20261027T190000Z
SUMMARY:Optional catch-up
TRANSP:TRANSPARENT
END:VEVENT
BEGIN:VEVENT
UID:example-cancelled-icloud
DTSTAMP:20261020T120000Z
DTSTART:20261027T200000Z
DTEND:20261027T210000Z
SUMMARY:Cancelled catch-up
STATUS:CANCELLED
END:VEVENT
END:VCALENDAR
