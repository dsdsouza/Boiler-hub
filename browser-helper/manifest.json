{
  "manifest_version": 3,
  "name": "Boilerplate Calendar Finder",
  "version": "1.1.0",
  "description": "Find a school calendar subscription link on the page you choose, then review it in Boilerplate.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Find a school calendar link",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boilerhub.work/*",
        "https://www.boilerhub.work/*",
        "https://boilerplate.zhomander.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
